{
  "name": "mcp-1c-platform-tools",
  "displayName": "1C: Platform Tools MCP",
  "description": "MCP-сервер для запуска команд 1c-platform-tools через агентов Cursor/VS Code",
  "keywords": [
    "1c",
    "1с",
    "1c platform",
    "1c enterprise",
    "1с предприятие",
    "bsl",
    "mcp",
    "cursor",
    "1c platform tools"
  ],
  "version": "0.1.9",
  "publisher": "yellow-hammer",
  "main": "./out/src/extension.js",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "yellow-hammer.1c-platform-tools"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mcp-1c-platform-tools",
        "label": "1C: Platform Tools MCP"
      }
    ],
    "commands": [
      {
        "command": "mcp-1c-platform-tools.configureCursor",
        "title": "Настроить MCP для Cursor (.cursor/mcp.json)",
        "category": "1C: Platform Tools MCP"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellow-hammer/mcp-1c-platform-tools.git"
  },
  "bugs": {
    "url": "https://github.com/yellow-hammer/mcp-1c-platform-tools/issues"
  },
  "homepage": "https://github.com/yellow-hammer/mcp-1c-platform-tools#readme",
  "license": "MIT",
  "author": {
    "name": "Ivan Karlo",
    "email": "i.karlo@outlook.com",
    "url": "https://johnnyshut.github.io/"
  },
  "contributors": [
    "Ivan Karlo (i.karlo@outlook.com)"
  ],
  "icon": "resources/1c-icon.png",
  "scripts": {
    "build": "tsc && node esbuild.config.mjs",
    "dev": "tsx src/index.ts",
    "changelog": "git-cliff --config cliff.toml --output CHANGELOG.md",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "test": "npm run build && node --test out/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "^4.3.0",
    "@hono/node-server": "^2.0.5"
  }
}
